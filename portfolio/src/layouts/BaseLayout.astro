---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { defaultLocale, useTranslations, type Locale } from "../i18n";

const {
  title,
  description,
  lang = defaultLocale,
  noindex = false,
} = Astro.props as {
  title?: string;
  description?: string;
  lang?: Locale;
  noindex?: boolean;
};

const t = useTranslations(lang);
const finalTitle = title ?? t("meta.title");
const finalDescription = description ?? t("meta.description");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL("/og.png", Astro.site);
const socialImageWebp = new URL("/og.webp", Astro.site);
const socialImageJpg = new URL("/og.jpg", Astro.site);

// hreflang alternates: the Spanish version of a path lives under the /es prefix.
// The 404 page is excluded (via `noindex`) because it has no language variants.
const currentPath = Astro.url.pathname;
const basePath = currentPath.startsWith("/es")
  ? currentPath.slice(3) || "/"
  : currentPath;
const alternates = noindex
  ? []
  : [
      { lang: "en", href: new URL(basePath, Astro.site) },
      {
        lang: "es",
        href: new URL(basePath === "/" ? "/es/" : `/es${basePath}`, Astro.site),
      },
      { lang: "x-default", href: new URL(basePath, Astro.site) },
    ];

// Structured data: WebSite + the person behind it, on every page.
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": new URL("/#website", Astro.site).href,
      name: "Yapplic",
      url: new URL("/", Astro.site).href,
      description: t("meta.description"),
      inLanguage: lang,
      publisher: { "@id": new URL("/#person", Astro.site).href },
    },
    {
      "@type": "Person",
      "@id": new URL("/#person", Astro.site).href,
      name: "Jordi Toda",
      jobTitle: "Mobile app developer",
      url: new URL("/about", Astro.site).href,
      sameAs: ["https://github.com/jorditoda"],
    },
  ],
};
---
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{finalTitle}</title>
    <meta name="description" content={finalDescription} />
    <meta name="generator" content={Astro.generator} />
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex" />}

    <!-- Language alternates -->
    {alternates.map((alternate) => (
      <link
        rel="alternate"
        hreflang={alternate.lang}
        href={alternate.href}
      />
    ))}

    <!-- Favicon -->
    <!-- Keep /favicon.ico in place: browsers and clients that probe the default
         path directly would otherwise 404 or fall back to a stale cached icon.
         The SVG is preferred where supported because it adapts to the colour
         scheme; the ICO/PNG stay as static fallbacks. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Yapplic" />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yapplic — Simple, fast and delightful mobile apps" />
    <!-- Lighter variants for consumers that support them, kept behind the PNG above -->
    <meta property="og:image" content={socialImageWebp} />
    <meta property="og:image:type" content="image/webp" />
    <meta property="og:image" content={socialImageJpg} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
    <meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={finalTitle} />
    <meta name="twitter:description" content={finalDescription} />
    <meta name="twitter:image" content={socialImageWebp} />
    <meta name="twitter:image:width" content="1200" />
    <meta name="twitter:image:height" content="630" />

    <link rel="stylesheet" href="/styles.css" />

    <!-- Structured data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Resolve the theme before first paint to avoid a flash of the wrong theme -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem("theme"); } catch (e) {}
        if (theme !== "dark" && theme !== "light") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        var root = document.documentElement;
        root.classList.add(theme);
        root.style.colorScheme = theme;
      })();
    </script>

    <!-- Keep sections visible when JavaScript is disabled -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>

  <body>
    <Header lang={lang} />

    <main>
      <slot />
    </main>

    <Footer lang={lang} />
  </body>
</html>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Scroll reveal
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("visible");
        });
      },
      { threshold: 0.2 }
    );

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

    // Theme (the initial theme is resolved by the inline script in <head>)
    const setTheme = (theme: "dark" | "light") => {
      const root = document.documentElement;
      root.classList.toggle("dark", theme === "dark");
      root.classList.toggle("light", theme === "light");
      root.style.colorScheme = theme;
      const btn = document.getElementById("theme-toggle");
      if (btn) btn.setAttribute("aria-pressed", String(theme === "dark"));
    };

    const toggle = document.getElementById("theme-toggle");
    if (toggle) {
      // Keep the accessible state in sync with the theme already applied in <head>
      toggle.setAttribute(
        "aria-pressed",
        String(document.documentElement.classList.contains("dark"))
      );
      toggle.addEventListener("click", () => {
        const next = document.documentElement.classList.contains("dark") ? "light" : "dark";
        setTheme(next);
        try { localStorage.setItem("theme", next); } catch (e) {}
      });
    }

    // Follow OS theme changes, unless the user has chosen explicitly
    window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (event) => {
      let saved: string | null = null;
      try { saved = localStorage.getItem("theme"); } catch (e) {}
      if (saved === "dark" || saved === "light") return;
      setTheme(event.matches ? "dark" : "light");
    });

    // Header shrink
    const header = document.getElementById("site-header");
    if (header) {
      const onScrollHeader = () => {
        if (window.scrollY > 40) {
          header.classList.add("shrink");
        } else {
          header.classList.remove("shrink");
        }
      };
      window.addEventListener("scroll", onScrollHeader);
      onScrollHeader();
    }
  });
</script>
