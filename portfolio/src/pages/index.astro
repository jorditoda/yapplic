---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneMockup from "../components/PhoneMockup.astro";
import { Image } from "astro:assets";

import rallyHudIcon from "../assets/icons/rallyhud.png";
import likeThisIcon from "../assets/icons/likethis.png";
import pointerPointerIcon from "../assets/icons/pointerpointer.png";
import holdKingIcon from "../assets/icons/holdking.png";
import sadTromboneIcon from "../assets/icons/sadtrombone.png";

import rallyHudScreen from "../assets/screens/rallyhud-1.png";
import likeThisScreen from "../assets/screens/likethis-1.png";
import pointerPointerScreen from "../assets/screens/pointerpointer-1.png";
import holdKingScreen from "../assets/screens/holdking-1.png";
import sadTromboneScreen from "../assets/screens/sadtrombone-1.png";

const apps = [
  {
    id: "rally-hud",
    title: "Rally HUD",
    description: "A clean and readable HUD for rally drivers.",
    icon: rallyHudIcon,
    screenshot: rallyHudScreen,
    link: "https://rallyhud.yapplic.com",
    color: "#E8F0FF"
  },
  {
    id: "like-this",
    title: "Like This",
    description: "Share and discover recommendations effortlessly.",
    icon: likeThisIcon,
    screenshot: likeThisScreen,
    link: "https://someonelikethis.yapplic.com",
    color: "#FFF3E8"
  },
  {
    id: "pointerpointer",
    title: "PointerPointer",
    description: "A fast-paced precision and reflex game.",
    icon: pointerPointerIcon,
    screenshot: pointerPointerScreen,
    link: "https://pointerpointer.yapplic.com",
    color: "#E8FFF1"
  },
  {
    id: "hold-king",
    title: "Hold King",
    description: "How long can you hold the button?",
    icon: holdKingIcon,
    screenshot: holdKingScreen,
    link: "https://holdking.yapplic.com",
    color: "#FFF0F6"
  },
  {
    id: "sad-trombone",
    title: "Sad Trombone",
    description: "The classic fail sound effect, always ready.",
    icon: sadTromboneIcon,
    screenshot: sadTromboneScreen,
    link: "https://sadtrombone.yapplic.com",
    color: "#F3F3F3"
  }
];
---

<BaseLayout title="Yapplic - Portfolio">

  <!-- HERO -->
  <section class="hero fade-in">
    <h1 class="slide-up">Yapplic</h1>
    <p class="slide-up delay-1">
      Mobile app developer crafting simple, fast and delightful experiences.
    </p>
  </section>

  <!-- APPS FULL SECTIONS -->
  {apps.map((app, index) => (
    <section
      id={app.id}
      class={`app-section reveal ${index % 2 === 0 ? "left" : "right"}`}
      style={`--app-bg:${app.color};`}
    >
      <div class="app-text">
        <Image
          src={app.icon}
          alt={app.title}
          class="app-icon"
          width={128}
          format="webp"
          loading="lazy"
        />
        <h2>{app.title}</h2>
        <p>{app.description}</p>
        <a href={app.link} class="cta-button" target="_blank" rel="noopener">
          Learn more about {app.title}<span class="sr-only"> (opens in a new tab)</span>
        </a>
      </div>

      <div class="app-mockup">
        <PhoneMockup
          image={app.screenshot}
          alt={`${app.title} app screenshot`}
        />
      </div>
    </section>
  ))}

</BaseLayout>
