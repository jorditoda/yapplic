---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n";

const t = useTranslations("en");

// GitHub Pages serves this one file for every missing URL, so Spanish
// visitors (under /es/) get their copy swapped in by the script below.
const es = useTranslations("es");
const spanish = {
  title: es("notFound.title"),
  heading: es("notFound.heading"),
  body: es("notFound.body"),
  alt: es("notFound.bodyAlt"),
  cta: es("notFound.cta"),
};
---

<BaseLayout
  title={t("notFound.title")}
  description={t("notFound.description")}
  lang="en"
  noindex
>

  <section class="about-hero fade-in" id="not-found" data-es={JSON.stringify(spanish)}>
    <h1 class="slide-up">{t("notFound.heading")}</h1>
    <p class="slide-up delay-1">{t("notFound.body")}</p>
    <p class="not-found-alt slide-up delay-2">{t("notFound.bodyAlt")}</p>
    <a href="/" class="cta-button slide-up delay-2">{t("notFound.cta")}</a>
  </section>

</BaseLayout>

<script is:inline>
  if (location.pathname === "/es" || location.pathname.startsWith("/es/")) {
    var root = document.getElementById("not-found");
    var spanish = JSON.parse(root.dataset.es);
    var q = function (sel) { return document.querySelector("#not-found " + sel); };
    document.documentElement.lang = "es";
    document.title = spanish.title;
    q("h1").textContent = spanish.heading;
    q("p").textContent = spanish.body;
    q(".not-found-alt").textContent = spanish.alt;
    var cta = q(".cta-button");
    cta.textContent = spanish.cta;
    cta.setAttribute("href", "/es/");
  }
</script>

<style>
  .not-found-alt {
    opacity: 0.6;
    font-size: 1rem;
    margin-top: -0.5rem;
  }

  .about-hero .cta-button {
    display: inline-block;
    margin-top: 1.5rem;
  }
</style>
