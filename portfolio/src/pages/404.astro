---
import BaseLayout from "../layouts/BaseLayout.astro";
import { locales, useTranslations } from "../i18n";

const t = useTranslations("en");

// GitHub Pages serves this one file for every missing URL, so visitors under a
// locale prefix (/es/, /ca/) get their copy swapped in by the script below.
const translated = Object.fromEntries(
  locales
    .filter((locale) => locale !== "en")
    .map((locale) => {
      const tl = useTranslations(locale);
      return [
        locale,
        {
          title: tl("notFound.title"),
          heading: tl("notFound.heading"),
          body: tl("notFound.body"),
          alt: tl("notFound.bodyAlt"),
          cta: tl("notFound.cta"),
        },
      ];
    })
);
---

<BaseLayout
  title={t("notFound.title")}
  description={t("notFound.description")}
  lang="en"
  noindex
>

  <section class="about-hero fade-in" id="not-found" data-translations={JSON.stringify(translated)}>
    <h1 class="slide-up">{t("notFound.heading")}</h1>
    <p class="slide-up delay-1">{t("notFound.body")}</p>
    <p class="not-found-alt slide-up delay-2">{t("notFound.bodyAlt")}</p>
    <a href="/" class="cta-button slide-up delay-2">{t("notFound.cta")}</a>
  </section>

</BaseLayout>

<script is:inline>
  var root = document.getElementById("not-found");
  var locale = location.pathname.split("/")[1];
  var copy = JSON.parse(root.dataset.translations)[locale];
  if (copy) {
    var q = function (sel) { return root.querySelector(sel); };
    document.documentElement.lang = locale;
    document.title = copy.title;
    q("h1").textContent = copy.heading;
    q("p").textContent = copy.body;
    q(".not-found-alt").textContent = copy.alt;
    var cta = q(".cta-button");
    cta.textContent = copy.cta;
    cta.setAttribute("href", "/" + locale + "/");
  }
</script>

<style>
  .not-found-alt {
    opacity: 0.6;
    font-size: 1rem;
    margin-top: -0.5rem;
  }

  .about-hero .cta-button {
    display: inline-block;
    margin-top: 1.5rem;
  }
</style>
