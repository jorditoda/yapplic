---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneMockup from "./PhoneMockup.astro";
import StoreBadges from "./StoreBadges.astro";
import { apps } from "../data/apps";
import { Image } from "astro:assets";
import { defaultLocale, useTranslations, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

const platformNames = { ios: "iOS", android: "Android" } as const;



// Structured data: one SoftwareApplication per app, in the page's language
const softwareItemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: t("meta.appsList"),
  itemListElement: apps.map((app, index) => ({
    "@type": "ListItem",
    position: index + 1,
    item: {
      "@type": "SoftwareApplication",
      name: app.title,
      description: `${app.tagline[lang]} ${app.details[lang]}`,
      applicationCategory: app.category,
      url: app.link ?? app.appStore ?? app.playStore,
      image: new URL(app.icon.src, Astro.site).href,
      inLanguage: lang,
      author: { "@id": new URL("/#person", Astro.site).href },
    },
  })),
};
---

<BaseLayout
  title={t("meta.title")}
  description={t("meta.description")}
  lang={lang}
>

  <script type="application/ld+json" set:html={JSON.stringify(softwareItemList)} />

  <!-- HERO -->
  <section class="hero fade-in">
    <h1 class="slide-up">Yapplic</h1>
    <p class="hero-tagline slide-up delay-1">{t("hero.tagline")}</p>
    <p class="hero-sub slide-up delay-1">{t("hero.sub")}</p>

    <nav class="app-grid slide-up delay-2" aria-label={t("hero.appsNav")}>
      {apps.map((app) => (
        <a href={`#${app.id}`}>
          <Image src={app.icon} alt="" width={112} height={112} format="webp" />
          <span>{app.title}</span>
        </a>
      ))}
    </nav>
  </section>

  <!-- APPS FULL SECTIONS -->
  <section id="apps">
  {apps.map((app, index) => (
    <section
      id={app.id}
      class={`app-section reveal ${index % 2 === 0 ? "left" : "right"}`}
      style={`--app-bg:${app.color};`}
    >
      <div class="app-text">
        <Image
          src={app.icon}
          alt=""
          class="app-icon"
          width={128}
          format="webp"
          loading="lazy"
        />
        <h2>{app.title}</h2>
        <p>{app.tagline[lang]}</p>
        <p>{app.details[lang]}</p>
        <p class="app-platforms">
          {app.platforms.map((p) => platformNames[p]).join(" · ")}
        </p>
        <StoreBadges app={app} lang={lang} />
        {app.link && (
          <a href={app.link} class="app-link" target="_blank" rel="noopener">
            {t("app.cta").replace("{title}", app.title)}<span class="sr-only">{t("link.newTab")}</span>
          </a>
        )}
      </div>

      <div class="app-mockup">
        <PhoneMockup
          image={app.screenshot}
          alt={t("app.screenshotAlt").replace("{title}", app.title)}
        />
      </div>
    </section>
  ))}
  </section>

</BaseLayout>
