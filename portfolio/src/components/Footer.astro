---
import { defaultLocale, useTranslations, type Locale } from "../i18n";

const { lang = defaultLocale } = Astro.props as { lang?: Locale };
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer">
  <nav class="footer-nav">
    <a href={lang === "es" ? "/es/" : "/"}>{t("nav.home")}</a>
    <a href={lang === "es" ? "/es/about" : "/about"}>{t("nav.about")}</a>
    <a href="https://github.com/jorditoda" target="_blank" rel="noopener" class="github-link"> GitHub<span class="sr-only">{t("link.newTab")}</span></a>
    </nav>

  <script  data-name="bmc-button" data-slug="stormfkrs" data-color="#FFDD00" data-emoji="🍺" data-font="Cookie" data-text={t("footer.donate")} data-outline-color="#000000" data-font-color="#000000" data-coffee-color="#ffffff" src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"></script>

  <p>© {year} Yapplic — {t("footer.built")} Jordi Toda — {t("footer.made")}</p>
</footer>

<style>
  .footer {
    text-align: center;
    padding: 3rem 0;
    margin-top: 4rem;
    color: var(--muted);
    font-size: 0.9rem;
    border-top: 1px solid rgba(0,0,0,0.05);
  }

  @media (prefers-color-scheme: dark) {
    :root:not(.light) .footer {
      border-top: 1px solid rgba(255,255,255,0.1);
    }
  }

  :root.dark .footer {
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .footer-nav {
    margin-bottom: 1rem;
  }

  .footer-nav a {
    margin: 0 1rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--accent);
  }
</style>
