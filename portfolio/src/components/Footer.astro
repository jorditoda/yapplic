---
import { defaultLocale, localePath, stripLocale, useTranslations, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const currentPath = stripLocale(Astro.url.pathname).replace(/\/$/, "") || "/";
const current = (path: string) => (currentPath === path ? "page" : undefined);
const year = new Date().getFullYear();
---

<footer class="footer">
  <nav class="footer-nav">
    <a href={`${localePath(lang)}#apps`}>{t("nav.apps")}</a>
    <a href={localePath(lang, "/about")} aria-current={current("/about")}>{t("nav.about")}</a>
    <a href="https://github.com/jorditoda" target="_blank" rel="noopener" class="github-link">GitHub<span class="sr-only">{t("link.newTab")}</span></a>
    <a href="https://www.linkedin.com/in/jordi-toda/" target="_blank" rel="noopener">LinkedIn<span class="sr-only">{t("link.newTab")}</span></a>
  </nav>

  <a href="https://www.buymeacoffee.com/stormfkrs" target="_blank" rel="noopener" class="donate">
    <span aria-hidden="true">🍺</span> {t("footer.donate")}<span class="sr-only">{t("link.newTab")}</span>
  </a>

  <p>© {year} Yapplic — {t("footer.made")}</p>
</footer>

<style>
  .footer {
    text-align: center;
    padding: 3rem 1rem;
    margin-top: 4rem;
    color: var(--muted);
    font-size: 0.9rem;
    border-top: 1px solid var(--border);
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2rem;
    margin-bottom: 1rem;
  }

  .footer-nav a {
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: var(--accent);
  }

  .donate {
    display: inline-block;
    margin: 0.5rem 0 1.5rem;
    padding: 0.6rem 1.2rem;
    background: var(--accent);
    color: var(--cta-text);
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .donate:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  .donate:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
