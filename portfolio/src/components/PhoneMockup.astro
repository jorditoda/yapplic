---
import { Image } from "astro:assets";

const { image, alt } = Astro.props;

// The frame is a fixed 260px wide with 12px of padding on each side, so the
// screenshot always renders at 236 CSS pixels. Offering 1x/2x/3x candidates
// keeps retina sharp while letting small screens fetch a much smaller file.
const widths = [236, 472, 708];
---

<div class="phone">
  <Image
    src={image}
    alt={alt}
    widths={widths}
    sizes="236px"
    format="webp"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
.phone {
  width: 260px;
  padding: 12px;
  border-radius: 32px;
  background: #000;
  border: 2px solid #333;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.phone img {
  width: 100%;
  height: auto;
  border-radius: 22px;
}
</style>
