---
import { Image } from "astro:assets";

const { image, alt = "App screenshot", width } = Astro.props;
---

<div class="phone">
  <Image
    src={image}
    alt={alt}
    width={width}
    format="webp"
    loading="lazy"
    decoding="async"
  />
</div>

<style>
.phone {
  width: 260px;
  padding: 12px;
  border-radius: 32px;
  background: #000;
  border: 2px solid #333;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0,0,0,0.2);
}

.phone img {
  width: 100%;
  height: auto;
  border-radius: 22px;
}
</style>
