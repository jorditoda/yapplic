---
import {
  defaultLocale,
  localeNames,
  localePath,
  localeSwitchLabels,
  stripLocale,
  useTranslations,
  type Locale,
} from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const currentPath = stripLocale(Astro.url.pathname).replace(/\/$/, "") || "/";
const current = (path: string) => (currentPath === path ? "page" : undefined);

// Point the switcher at the same page in the other language
const basePath = stripLocale(Astro.url.pathname);
const switchLang: Locale = lang === "en" ? "es" : "en";
const switchHref = localePath(switchLang, basePath);
---

<header class="header" id="site-header">
  <a href={localePath(lang)} class="logo">Yapplic</a>

  <nav class="nav">
    <a href={localePath(lang)} aria-current={current("/")}>{t("nav.home")}</a>
    <a href={localePath(lang, "/about")} aria-current={current("/about")}>{t("nav.about")}</a>
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label={t("theme.toggle")}
      aria-pressed="false"
    >🌓</button>
    <a
      href={switchHref}
      class="lang-switch"
      lang={switchLang}
      aria-label={localeSwitchLabels[switchLang]}
    >{localeNames[switchLang]}</a>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: var(--header-bg);
    border-bottom: 1px solid var(--border);
    transition: padding 0.3s ease, background 0.3s ease, backdrop-filter 0.3s ease;
  }

  /* Shrink effect */
  .header.shrink {
    padding: 0.4rem 2rem;
    background: var(--header-bg-shrink);
    backdrop-filter: blur(20px);
  }

  .logo {
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    font-size: 1.1rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a {
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--accent);
  }

  /* Theme toggle button */
  .theme-toggle {
    background: none;
    border: none;
    padding: 0;
    font-size: 1.2rem;
    cursor: pointer;
    color: var(--text);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .theme-toggle:hover {
    opacity: 0.6;
    transform: scale(1.1);
  }

  /* Language switcher */
  .lang-switch {
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .lang-switch:hover {
    border-color: var(--accent);
  }

  /* Small phones: tighter spacing so logo + nav fit on one row */
  @media (max-width: 480px) {
    .header,
    .header.shrink {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .nav {
      gap: 0.9rem;
      font-size: 0.9rem;
    }
  }
</style>
