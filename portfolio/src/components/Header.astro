---
import {
  defaultLocale,
  localeNames,
  localePath,
  localeSwitchLabels,
  stripLocale,
  useTranslations,
  type Locale,
} from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);

// Point the switcher at the same page in the other language
const basePath = stripLocale(Astro.url.pathname);
const switchLang: Locale = lang === "en" ? "es" : "en";
const switchHref = localePath(switchLang, basePath);
---

<header class="header" id="site-header">
  <a href={localePath(lang)} class="logo">Yapplic</a>

  <nav class="nav">
    <a href={localePath(lang)}>{t("nav.home")}</a>
    <a href={localePath(lang, "/about")}>{t("nav.about")}</a>
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label={t("theme.toggle")}
      aria-pressed="false"
    >🌓</button>
    <a
      href={switchHref}
      class="lang-switch"
      lang={switchLang}
      aria-label={localeSwitchLabels[switchLang]}
    >{localeNames[switchLang]}</a>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(255,255,255,0.6);
    border-bottom: 1px solid rgba(0,0,0,0.05);
    transition: padding 0.3s ease, background 0.3s ease, backdrop-filter 0.3s ease;
  }

  /* Shrink effect */
  .header.shrink {
    padding: 0.4rem 2rem;
    background: rgba(255,255,255,0.75);
    backdrop-filter: blur(20px);
  }

  /* Dark mode (class applied by JS) */
  :root.dark .header {
    background: rgba(0,0,0,0.4);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  :root.dark .header.shrink {
    background: rgba(0,0,0,0.55);
  }

  /* OS dark mode without a theme class (e.g. JavaScript disabled) */
  @media (prefers-color-scheme: dark) {
    :root:not(.light) .header {
      background: rgba(0,0,0,0.4);
      border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    :root:not(.light) .header.shrink {
      background: rgba(0,0,0,0.55);
    }
  }

  .logo {
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    font-size: 1.1rem;
  }

  .nav a {
    margin-left: 1.5rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--accent);
  }

  /* Theme toggle button */
  .theme-toggle {
    margin-left: 1.5rem;
    background: none;
    border: none;
    font-size: 1.2rem;
    cursor: pointer;
    color: var(--text);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .theme-toggle:hover {
    opacity: 0.6;
    transform: scale(1.1);
  }

  /* Language switcher */
  .lang-switch {
    margin-left: 1.5rem;
    text-decoration: none;
    color: var(--text);
    font-weight: 600;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.6rem;
    border: 1px solid rgba(0,0,0,0.15);
    border-radius: 999px;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .lang-switch:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  :root.dark .lang-switch {
    border-color: rgba(255,255,255,0.25);
  }

  @media (prefers-color-scheme: dark) {
    :root:not(.light) .lang-switch {
      border-color: rgba(255,255,255,0.25);
    }
  }
</style>
