---
import { Image } from "astro:assets";
import avatar from "../assets/avatar.svg";
import BaseLayout from "../layouts/BaseLayout.astro";
import { defaultLocale, localePath, ui, useTranslations, type Locale } from "../i18n";

interface Props {
  lang?: Locale;
}

const { lang = defaultLocale } = Astro.props;
const t = useTranslations(lang);
const aboutItems = ui[lang]["about.what.items"];
const technologies = ["Swift", "Kotlin", "Flutter", "Firebase", "Astro", "TypeScript"];
---

<BaseLayout
  title={t("about.title")}
  description={t("about.description")}
  lang={lang}
>

  <!-- HERO -->
  <section class="about-hero fade-in">
    <Image src={avatar} alt="" width={120} height={120} class="about-avatar slide-up" loading="eager" />
    <h1 class="slide-up">{t("about.heading")}</h1>
    <p class="slide-up delay-1">
      {t("about.lead")}
    </p>
  </section>

  <!-- WHO I AM -->
  <section class="about-section reveal apple-anim">
    <h2>{t("about.who.title")}</h2>
    <p>{t("about.who.body")}</p>
  </section>

  <!-- WHAT I DO -->
  <section class="about-section reveal apple-anim">
    <h2>{t("about.what.title")}</h2>
    <ul class="about-list">
      {aboutItems.map((item) => <li>{item}</li>)}
    </ul>
  </section>

  <!-- TECHNOLOGIES -->
  <section class="about-section reveal apple-anim">
    <h2>{t("about.tech.title")}</h2>
    <div class="tech-grid">
      {technologies.map((tech) => <span>{tech}</span>)}
    </div>
  </section>

  <!-- LINKS -->
  <section class="about-section about-links reveal apple-anim">
    <a href={`${localePath(lang)}#apps`} class="cta-button">{t("about.cta.apps")}</a>
    <a href="https://www.linkedin.com/in/jordi-toda/" class="cta-button cta-secondary" target="_blank" rel="noopener">LinkedIn<span class="sr-only">{t("link.newTab")}</span></a>
  </section>

</BaseLayout>
